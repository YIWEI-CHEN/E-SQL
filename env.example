BIRD_DB_PATH="../dataset/bird-sql"
OPENAI_API_KEY=<Your OpenAI API key>

# Dataverse P1 connectivity smoke tests.
# The three values below can point to separate Dataverse environments, or to
# the same environment if the experiment tables are deployed together.
DATAVERSE_ENV_SOCCER=https://<soccer-org>.crm.dynamics.com
DATAVERSE_ENV_CALIFORNIA_SCHOOLS=https://<california-schools-org>.crm.dynamics.com
DATAVERSE_ENV_STUDENT_CLUB=https://<student-club-org>.crm.dynamics.com
DATAVERSE_TENANT_ID=<your-tenant-id>
# Auth mode: auto, azure_cli, device_code, or browser. Use browser/device_code
# if Azure CLI is logged into the wrong tenant.
DATAVERSE_AUTH_MODE=auto
# Optional override. If omitted, the helper requests a token for
# <DATAVERSE_ENV_...>/.default.
# DATAVERSE_TDS_SCOPE=https://<org>.crm.dynamics.com/.default
# Optional override for Invoke-Sqlcmd access-token resource.
# DATAVERSE_TDS_RESOURCE=https://<org>.crm.dynamics.com

# Optional non-interactive auth. If omitted, the helper uses Azure CLI first
# and then device-code auth with a local token cache.
# DATAVERSE_CLIENT_ID=<application-client-id>
# DATAVERSE_CLIENT_SECRET=<application-client-secret>